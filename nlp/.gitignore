# ===========================================
# Node / JS / TS / Full-Stack .gitignore
# With AWS key protection
# ===========================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example        # keep a template only
*.env.local
*.secrets
secrets.json

# Explicitly ignore AWS credential patterns
aws_credentials
aws_keys
*.pem
*.p12
*.key
config/aws-credentials.json

# OS Files
.DS_Store
Thumbs.db

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# --- Logs ---
logs
*.log
logs/*.log
debug.log

# --- Build outputs ---
dist/
build/
out/
.next/
.vercel/
.netlify/

# --- Cache ---
.cache/
.temp/
*.pid
*.seed
*.pid.lock

# --- TypeScript ---
*.tsbuildinfo

# --- React / Vite ---
.vite/
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# --- Editor junk ---
.vscode/
.idea/
*.swp
*.swo

# --- Temporary files ---
*.tmp
*.bak
*.old

# --- Python (if you use scripts) ---
__pycache__/
*.pyc

# --- AWS CLI default credentials directory (optional) ---
.aws/
